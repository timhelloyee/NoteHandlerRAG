# Secrets
.env
.env.*
!.env.example

# Original notebook kept local only (contains hardcoded keys)
NoteHandler.ipynb

# Vector stores — data lives only in the private HF Dataset, never committed here
# (avoids leaking user emails / note content in a public repo).
vectorstores/

# Source note files not needed by the deployed app (kept local only)
pdf/

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
venv/
env/

# Cached Gemini page extractions (regenerable, and they contain note content)
eval/cache/
eval/corpus/

# B0 working kit: contains the user's note content, regenerable from the corpus
eval/b0/pages/
eval/b0/pages v2/
eval/b0/*_校正問題.md
eval/RESULTS_gating.txt

# local dev store (dev_server.py) — never the real vectorstores
.devstore/

# machine-local Claude Code permissions (launch.json is shared, this is not)
.claude/settings.local.json

# UI editor undo snapshot, not source
*.html.bak
