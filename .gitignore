# Secrets
.env
.env.*
!.env.example

# No notebooks: the project uses plain Python scripts (scripts/notehandler_input.py /
# scripts/notehandler_output.py). Notebooks also save their outputs, which here meant note text.
*.ipynb

# Vector stores — data lives only in the private HF Dataset, never committed here
# (avoids leaking user emails / note content in a public repo).
vectorstores/

# Source note files not needed by the deployed app (kept local only)
pdf/

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
venv/
env/

# G0: hand-corrected transcripts of the author's real notes (the gold standard for
# character error rate) and the raw whole-page Gemini baseline. Both are note content.
eval/g0/

# Full results of the retired retrieval-structure line; per-probe rows quote note content
eval/RESULTS_gating.txt

# R0 baseline: the answer key and the handwritten scans stay local
# (the key would leak the test; scans show the author's handwriting)
eval/r0/題組與標準答案.md
eval/r0/標準辨識稿.md
eval/r0/關鍵事實.md
eval/r0/關鍵事實.sha256.txt
# NotebookLM's answers are close to the answer key
eval/r0/NotebookLM_提問單.md
eval/r0/*.jpg
eval/r0/*.jpeg
eval/r0/*.png
eval/r0/*.pdf
eval/r0/results/

# local dev store (scripts/dev_server.py) — never the real vectorstores
.devstore/

# machine-local Claude Code permissions (launch.json is shared, this is not)
.claude/settings.local.json

# UI editor undo snapshot, not source
*.html.bak
